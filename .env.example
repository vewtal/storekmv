# Скопируйте в .env (локально) или задайте эти переменные в панели хостинга.
# ФАЙЛ .env НЕ КОММИТИТЬ — он в .gitignore.

# SMTP-доступ почтового ящика, от имени которого уходят письма с заявками
SMTP_HOST=smtp.yourprovider.ru
SMTP_PORT=587
SMTP_USER=robot@storekmv.ru
SMTP_PASS=change-me

# Куда падают заявки и от кого письмо
LEAD_TO=i@vllobanov.ru
LEAD_FROM=robot@storekmv.ru
